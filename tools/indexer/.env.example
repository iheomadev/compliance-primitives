# Soroban RPC endpoint
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://soroban-rpc.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract IDs — set whichever contracts you've deployed.
# Leave empty to skip indexing that contract.
ALLOWLIST_CONTRACT_ID=
DENYLIST_CONTRACT_ID=
JURISDICTION_CONTRACT_ID=

# SQLite database file path (relative to cwd or absolute)
DB_PATH=compliance.db

# How often to poll for new events (milliseconds)
POLL_INTERVAL_MS=5000

# Ledger sequence to start from.
# 0 = auto-detect (will start from ~24h ago on the connected node).
# Set to a specific ledger if you know when your contracts were deployed.
START_LEDGER=0
